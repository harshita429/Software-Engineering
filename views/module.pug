extends layout

block content
  section.module-section
    form.module-form(method="GET", action="/module")
      .module-selector
        label.module-label MODULE:
        select.module-dropdown(name="module", onchange="this.form.submit()")
          option(value="") -- Select Module --
          option(value="CMP5012B", selected=(selectedModule === 'CMP5012B')) CMP5012B - Software Engineering
          option(value="CMP5013A", selected=(selectedModule === 'CMP5013A')) CMP5013A - Architectures and Operating Systems
          option(value="CMP5036A", selected=(selectedModule === 'CMP5036A')) CMP5036A - Information Retrieval

    if selectedModule
      .module-content
        .module-panel
          h3 Gantt Chart:
          .gantt-chart
            table.gantt-table
              thead
                tr
                  th Task
                  each week in ['Wk 1', 'Wk 2', 'Wk 3', 'Wk 4', 'Wk 5', 'Wk 6', 'Wk 7', 'Wk 8']
                    th= week
              tbody
                tr
                  td Research
                  td.gantt-bar
                  td.gantt-bar
                  td
                  td
                  td
                  td
                  td
                tr
                  td Planning
                  td
                  td.gantt-bar
                  td.gantt-bar
                  td
                  td
                  td
                  td
                tr
                  td Development
                  td
                  td
                  td.gantt-bar
                  td.gantt-bar
                  td.gantt-bar
                  td
                  td
                tr
                  td Testing
                  td
                  td
                  td
                  td
                  td.gantt-bar
                  td.gantt-bar
                  td
                tr
                  td Submission
                  td
                  td
                  td
                  td
                  td
                  td
                  td.gantt-bar

        .module-panel
          h3 Milestones:
          ul.milestones-list
            li
              span.milestone-name Project Brief Approved
              span.milestone-date Due: 01/03/2026
            li
              span.milestone-name Design Prototype
              span.milestone-date Due: 15/03/2026
            li
              span.milestone-name Implementation Complete
              span.milestone-date Due: 01/04/2026
            li
              span.milestone-name Final Submission
              span.milestone-date Due: 30/04/2026

        .module-panel
          h3 Activities & Deadlines:
          ul.activities-list
            li
              .activity-name Research report
              .activity-deadline Due: xx/xx/xx
            li
              .activity-name Group presentation
              .activity-deadline Due: xx/xx/xx
            li
              .activity-name Final project submission
              .activity-deadline Due: xx/xx/xx
            li
              .activity-name Peer review
              .activity-deadline Due: xx/xx/xx

    else
      .module-placeholder
        p Select a module from the dropdown above to view its details.
